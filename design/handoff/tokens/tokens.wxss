/* 由 design-system/design.mjs 从设计稿生成，勿手改；改设计稿后重新 handoff */
page {
  --color-bg: #08090A;
  --color-surface: #0F1011;
  --color-surface-2: #191A1B;
  --color-surface-3: #28282C;
  --color-line: #23252A;
  --color-line-soft: #18191A;
  --color-text-1: #F7F8F8;
  --color-text-2: #D0D6E0;
  --color-text-3: #8A8F98;
  --color-text-4: #62666D;
  --color-brand: #7170FF;
  --color-brand-soft: #5E6AD2;
  --color-brand-dim: #16172B;
  --color-brand-ink: #A8A8FF;
  --color-brand-deep: #4B4BD8;
  --color-border-strong: #5E6570;
  --color-ok: #27A644;
  --color-warn: #F5A623;
  --color-on-brand: #FFFFFF;
  --color-on-solid: #08090A;
  --color-semantic-text-primary: var(--color-text-1);
  --color-semantic-text-secondary: var(--color-text-2);
  --color-semantic-text-tertiary: var(--color-text-3);
  --color-semantic-text-link: var(--color-brand-ink);
  --color-semantic-text-on-action: var(--color-on-brand);
  --color-semantic-surface-page: var(--color-bg);
  --color-semantic-surface-card: var(--color-surface);
  --color-semantic-surface-raised: var(--color-surface-2);
  --color-semantic-action-primary: var(--color-brand-deep);
  --color-semantic-border-default: var(--color-line);
  --color-semantic-border-strong: var(--color-border-strong);
  --color-semantic-border-focus: var(--color-brand-ink);
  --spacing-s1: 8rpx;
  --spacing-s2: 16rpx;
  --spacing-s3: 24rpx;
  --spacing-s4: 32rpx;
  --spacing-s5: 40rpx;
  --spacing-s6: 48rpx;
  --spacing-s7: 64rpx;
  --spacing-s8: 80rpx;
  --spacing-s9: 96rpx;
  --spacing-s10: 128rpx;
  --spacing-s11: 192rpx;
  --spacing-s12: 256rpx;
  --radius-sm: 10rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-full: 1998rpx;
  --text-fs1: 22rpx;
  --text-fs2: 24rpx;
  --text-fs3: 26rpx;
  --text-fs4: 30rpx;
  --text-fs5: 34rpx;
  --text-fs6: 44rpx;
  --text-fs7: 56rpx;
  --text-fs8: 80rpx;
  --text-fs9: 112rpx;
  --leading-display: 1.05;
  --leading-title: 1.15;
  --leading-body: 1.5;
  --leading-prose: 1.7;
  --layout-container: 2400rpx;
  --layout-nav-h: 112rpx;
  --layout-tap: 88rpx;
  --layout-hairline: 2rpx;
  --layout-dot: 14rpx;
  --layout-icon-sm: 12rpx;
  --font-size-web-h1-min: 50rpx;
  --font-size-web-h1-max: 88rpx;
  --font-size-web-h2-min: 42rpx;
  --font-size-web-h2-max: 56rpx;
  --font-size-web-nav-btn: 26rpx;
}
